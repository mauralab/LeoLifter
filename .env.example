# PostgreSQL URL for the existing LeoDatabase database (never NEXT_PUBLIC_*).
DATABASE_URL=
APP_ORIGIN=http://127.0.0.1:3000
# Must match LeoBot Telegram:AuthLinkSecret; generate a random value with at least 32 bytes.
TELEGRAM_AUTH_SECRET=
# A separate random 32-byte-or-longer key for signing browser access tokens.
SESSION_SECRET=
