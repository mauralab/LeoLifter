# PostgreSQL URL for the existing LeoDatabase database (never NEXT_PUBLIC_*).
DATABASE_URL=
APP_ORIGIN=http://127.0.0.1:3000
# A separate random 32-byte-or-longer key for signing browser access tokens.
SESSION_SECRET=

# Optional absolute folder for program cover uploads; defaults to .program-media.
# Back up this folder alongside PostgreSQL.
# PROGRAM_MEDIA_ROOT=
